QBOT_DATABASE_PATH=data/qbot4k.sqlite3
# QBOT_DATABASE_URL=postgresql://qbot4k@127.0.0.1/qbot4k
QBOT_BACKUP_DIR=data/backups
QBOT_RAW_ARCHIVE_DIR=data/raw-events
QBOT_DEFAULT_COMMUNITY_SLUG=default
QBOT_ENABLED_SERVICES=web,jobs,analysis
QBOT_DASHBOARD_HOST=127.0.0.1
QBOT_DASHBOARD_PORT=8080
QBOT_WEB_READ_ONLY=false
QBOT_CUSTOMER_SIGNUP_ENABLED=false
QBOT_LOG_LEVEL=INFO

# Required when web is enabled
QBOT_DASHBOARD_SESSION_SECRET=replace-with-at-least-32-random-characters
QBOT_DISCORD_OAUTH_CLIENT_ID=
QBOT_DISCORD_OAUTH_CLIENT_SECRET=
QBOT_DISCORD_OAUTH_REDIRECT_URI=
QBOT_OPERATOR_GUILD_IDS=
QBOT_LEGAL_ORGANIZATION_NAME=
QBOT_LEGAL_CONTACT_EMAIL=
QBOT_LEGAL_JURISDICTION=
QBOT_LEGAL_EFFECTIVE_DATE=

# Optional machine-ingestion bearer token
QBOT_INGEST_API_TOKEN=

# Connectors
QBOT_DISCORD_BOT_TOKEN=
QBOT_DISCORD_GUILD_IDS=
QBOT_TWITCH_BOT_TOKEN=
QBOT_TWITCH_REFRESH_TOKEN=
QBOT_TWITCH_CLIENT_ID=
QBOT_TWITCH_CLIENT_SECRET=
QBOT_TWITCH_CHANNELS=its_not_qwerty
QBOT_TWITCH_EVENTSUB_SECRET=
QBOT_TWITCH_EVENTSUB_CALLBACK_URL=

# Safety and scheduling
QBOT_MAINTENANCE_INTERVAL_SECONDS=60
QBOT_ANALYTICS_INTERVAL_SECONDS=300
QBOT_BACKUP_INTERVAL_SECONDS=3600
QBOT_BACKUP_RETENTION_COUNT=48
QBOT_AUDIT_RETENTION_DAYS=90

# Stripe configuration
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
QBOT_STRIPE_PRICE_MONTHLY=
QBOT_STRIPE_PRICE_ANNUAL=
QBOT_STRIPE_BACKER_COUPON_ID=
QBOT_STRIPE_PORTAL_CONFIGURATION_ID=

# Resend claim delivery: use a verified sender address, without a display name.
# The key must allow sending email and reading domains for activation verification.
# Keep the API key private. Delivery stays disabled until all settings are present.
QBOT_REWARD_EMAIL_API_KEY=
QBOT_REWARD_EMAIL_FROM=
# Shared persistent encryption/signing key; preserve an existing deployment key.
QBOT_CREDENTIAL_ENCRYPTION_KEY=