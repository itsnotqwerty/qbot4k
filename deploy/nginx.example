server {
    listen 80;
    listen [::]:80;

    server_name intelligence.example.com;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;

    http2 on;

    server_name intelligence.example.com;

    ssl_certificate     /etc/letsencrypt/live/intelligence.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/intelligence.example.com/privkey.pem;

    # If Certbot created these files:
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    access_log /var/log/nginx/qbot4k-access.log;
    error_log  /var/log/nginx/qbot4k-error.log warn;

    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_connect_timeout 10s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;

        proxy_buffering on;
        proxy_redirect off;
    }
}